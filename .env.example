# ===========================================
# Environment Configuration Template
# Copy this to .env and fill in your values
# ===========================================

# === Database Configuration ===
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=zabbix

# === Zabbix Configuration ===
ZABBIX_SERVER_HOST=zabbix-server
ZABBIX_DB_HOST=postgres
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=changeme_secure_password

# === Grafana Configuration ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_admin_password

# === AI Chatbot Configuration (Week 6) ===
AI_MODEL_PATH=/app/models/mistral-7b-instruct-v0.1.Q4_K_M.gguf
AI_MODEL_TYPE=mistral
MAX_TOKENS=2048
TEMPERATURE=0.7

# === Authentication Service (Week 8) ===
JWT_SECRET_KEY=changeme_very_secure_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Vector Database - Milvus (Week 5) ===
MILVUS_HOST=milvus
MILVUS_PORT=19530

# === Resource Limits (for 8GB RAM) ===
MEMORY_LIMIT_ZABBIX=2g
MEMORY_LIMIT_GRAFANA=512m
MEMORY_LIMIT_AI=3g
MEMORY_LIMIT_POSTGRES=1g

# === Network Ports ===
EXTERNAL_PORT_ZABBIX=8080
EXTERNAL_PORT_GRAFANA=3000
EXTERNAL_PORT_AI_API=5000
EXTERNAL_PORT_AUTH_API=8000